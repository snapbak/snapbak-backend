# The API on port 80 (docs/deploy.md). deploy/setup-ubuntu.sh installs it with this box's user and repo path.
[Unit]
Description=Snapbak Cloud API (uvicorn)
After=network-online.target redis-server.service
Wants=network-online.target redis-server.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/snapbak-backend
# systemd reads .env itself; the venv's Python runs the app, no shell or tool manager in between.
EnvironmentFile=/home/ubuntu/snapbak-backend/.env
# Port 80 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStartPre=/home/ubuntu/snapbak-backend/.venv/bin/python -m alembic upgrade head
ExecStart=/home/ubuntu/snapbak-backend/.venv/bin/python -m uvicorn snapbak_backend.main:app --host 0.0.0.0 --port 80 --timeout-keep-alive 75
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

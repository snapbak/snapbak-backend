# Copy to .env (git-ignored); `just` loads it. Real environment variables win.

# The bearer token the app sends (debug builds send "dev").
SNAPBAK_TOKEN=dev

# Engines as provider:model. Providers: groq, openai, anthropic, gemini, fake.
# fake:echo, fake:edit, fake:fail and fake:slow answer without a model, for tests.
# One model polishes every chunk; the big one runs commands and, by default, corrects a refused answer.
SNAPBAK_POLISH=openai:gpt-6-luna
SNAPBAK_BIG=openai:gpt-6-luna
# The model that corrects a refused polish answer once; "none" for no retry. Empty: the big model.
SNAPBAK_CORRECTION=
# The polish model's temperature (models that take one, 0 to 2) and reasoning effort (models that reason).
SNAPBAK_POLISH_TEMPERATURE=0
SNAPBAK_POLISH_EFFORT=none
# Worked examples before each request: all, per_module or none.
SNAPBAK_EXAMPLES_POLICY=all
# Tried once when a model errors or times out, and joins one still asking after 10 s; leave empty for none.
SNAPBAK_FALLBACK=openai:gpt-6-luna

# Provider keys; only the providers you name need one.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Port for `just serve`.
PORT=8787

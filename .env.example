# Copy to .env (git-ignored); `just` loads it. Real environment variables win.

# The bearer token the app sends (debug builds send "dev").
SNAPBAK_TOKEN=dev

# Engines as provider:model. Providers: groq, openai, anthropic, gemini, fake.
# fake:echo, fake:edit, fake:fail and fake:slow answer without a model, for tests.
# One model polishes every chunk; the big one runs commands and, by default, corrects a refused answer.
SNAPBAK_POLISH=openai:gpt-6-luna
SNAPBAK_BIG=openai:gpt-6-luna
# The model that corrects a refused polish answer once; "none" for no retry. Empty: the big model.
SNAPBAK_CORRECTION=
# The model that translates captions (TRX-07). Empty: the big model.
# The meetings embeddings (MEETINGS.md); fake:hashed is the tests stand-in.
#SNAPBAK_EMBEDDINGS=openai:text-embedding-3-small
SNAPBAK_TRANSLATE=
# The polish model's temperature (models that take one, 0 to 2) and reasoning effort (models that reason).
SNAPBAK_POLISH_TEMPERATURE=0
SNAPBAK_POLISH_EFFORT=none
# Worked examples before each request: all, per_module or none.
SNAPBAK_EXAMPLES_POLICY=all
# Tried once when a model errors or times out, and joins one still asking after 10 s; leave empty for none.
SNAPBAK_FALLBACK=openai:gpt-6-luna

# Provider keys; only the providers you name need one.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Port for `just serve`.
PORT=8787

# Cloud transcripts (docs/cloud.md). Leave DATABASE_URL empty to serve dictation only.
# `just db-up` starts these on the ports below.
DATABASE_URL=postgresql+asyncpg://snapbak:dev@127.0.0.1:15432/snapbak
REDIS_URL=redis://127.0.0.1:16379/0
# One S3 bucket for dev and production, by folder: audio/, clips/, shares/ (SETUP.md).
S3_REGION=ap-south-1
S3_BUCKET=snapbak-media
# The `snapbak` IAM user's key (S3 only), dev and production alike. S3 uses only these, never ~/.aws or AWS_*.
SNAPBAK_AWS_ACCESS_KEY_ID=
SNAPBAK_AWS_SECRET_ACCESS_KEY=
# The base of the webhook URLs the vendors call back.
SNAPBAK_PUBLIC_URL=http://127.0.0.1:8787
# Share links: the page's base (https://snapbak.site in production) and the product home page its "Get Snapbak"
# opens, also where `/` redirects, so never the share host's own root (refused at start). The home page is still
# open (12 HLD open question 8); this one is a placeholder.
# The share base names localhost, its own host, so the API on 127.0.0.1 keeps FastAPI's JSON errors.
SNAPBAK_SHARE_BASE_URL=http://localhost:8787
SNAPBAK_HOME_URL=https://snapbak.app
# fake:<fixture> replays tests/fixtures/transcription/<fixture>; assemblyai+pyannote calls the vendors.
SNAPBAK_TRANSCRIPTION=fake:two-speakers-en
ASSEMBLYAI_API_KEY=
PYANNOTE_API_KEY=
PYANNOTE_WEBHOOK_SECRET=
# Signs the AssemblyAI webhook header per job; any long random string.
SNAPBAK_WEBHOOK_SECRET=dev-webhook-secret
# Voiceprint sealing keys: key ID to base64 of 32 random bytes (`openssl rand -base64 32`). This one is for dev only.
VOICEPRINT_KEYS='{"1": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}'

# Waitlist admin: bearer token required to claim an early-access spot. Leave empty to allow no claims.
SNAPBAK_WAITLIST_TOKEN=
